{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?teamkrachtindex\\.nl"
        }
      ],
      "destination": "/teamkrachtindex.html"
    },
    {
      "source": "/deel/:id",
      "destination": "/api/deel?d=:id"
    },
    {
      "source": "/uitslag/:token",
      "destination": "/api/uitslag?t=:token"
    },
    {
      "source": "/betaald",
      "destination": "/betaald.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    }
  ],
  "functions": {
    "api/duiding.js": {
      "maxDuration": 60
    },
    "api/scan.js": {
      "maxDuration": 15
    },
    "api/lead.js": {
      "maxDuration": 15
    },
    "api/deelzin.js": {
      "maxDuration": 30
    },
    "api/deelbeeld.js": {
      "maxDuration": 15
    },
    "api/deel.js": {
      "maxDuration": 10
    },
    "api/opvolg.js": {
      "maxDuration": 60
    },
    "api/afmelden.js": {
      "maxDuration": 10
    },
    "api/dagtaken.js": {
      "maxDuration": 15
    },
    "api/teamkracht-bereken.js": {
      "maxDuration": 30
    },
    "api/teamkracht-kaart.js": {
      "maxDuration": 20
    },
    "api/teamkracht-team.js": {
      "maxDuration": 20
    },
    "api/teamkracht-doel.js": {
      "maxDuration": 15
    },
    "api/teamkracht-teambeeld.js": {
      "maxDuration": 10
    },
    "api/teamkracht-interventies.js": {
      "maxDuration": 10
    },
    "api/teamkracht-doelregels.js": {
      "maxDuration": 10
    },
    "api/uitslag.js": {
      "maxDuration": 10
    },
    "api/teamkracht-beheer.js": {
      "maxDuration": 10
    },
    "api/instellingen-check.js": {
      "maxDuration": 10
    },
    "api/betaling-start.js": {
      "maxDuration": 20
    },
    "api/betaling-webhook.js": {
      "maxDuration": 20
    },
    "api/betaling-status.js": {
      "maxDuration": 10
    },
    "api/module-voortgang.js": {
      "maxDuration": 10
    },
    "api/prijslijst.js": {
      "maxDuration": 10
    },
    "api/prijs.js": {
      "maxDuration": 10
    },
    "api/organisatie.js": {
      "maxDuration": 20
    }
  },
  "crons": [
    {
      "path": "/api/opvolg",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/dagtaken",
      "schedule": "30 6 * * 1-5"
    }
  ],
  "redirects": [
    {
      "source": "/:pad(scan|scan_lg|scan_mw|quick_scan|index|sprint|dashboard|dashboard-index|teamkracht|teamkracht-beheer|teamkracht-demo|teamkracht-doel|teamkracht-handleiding|teamkracht-voorbeeld|module|account|betaald|bedankt|organisatie|professionals)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?teamkrachtindex\\.nl"
        }
      ],
      "destination": "https://scan.happly.nl/:pad",
      "permanent": false
    },
    {
      "source": "/:pad(uitslag|deel)/:rest*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?teamkrachtindex\\.nl"
        }
      ],
      "destination": "https://scan.happly.nl/:pad/:rest*",
      "permanent": false
    }
  ]
}
